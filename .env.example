# Pillar A ingestion scheduler (set true to enable hourly research runs)
FF_PILLAR_A_INGESTION=true
INGESTION_CRON=0 * * * *
JOB_MAX_RETRIES=3

# Pillar A trend source adapter v1 (set true to enable Google Trends ingestion)
FF_PILLAR_A_SOURCE_V1=true
PILLAR_A_SOURCE_V1_GEO=US
PILLAR_A_SOURCE_V1_LANG=en-US
PILLAR_A_SOURCE_V1_MAX_PAGES=1
PILLAR_A_SOURCE_V1_TIMEOUT_SECONDS=15
PILLAR_A_SOURCE_V1_VELOCITY_BASELINE=1000
PILLAR_A_SOURCE_V1_CONFIDENCE_BASELINE=0.7

# Pillar A research persistence
RESEARCH_RETENTION_DAYS=30

# Supabase persistent state (Priority 1 — Phase 2)
# Required tables: system_state, events  (see backend/integrations/supabase_client.py)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# FRED / S&P macro signals (Priority 2 — Phase 2)
# Free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key
# Optional S&P Global premium (reserved for future use)
ICE_API_KEY=

# Adobe Journey Optimizer (Priority 3 — Phase 2)
# Bearer token from Adobe Developer Console
ADOBE_AJO_TOKEN=your-ajo-bearer-token
# IMS Organisation ID from Adobe Admin Console
ADOBE_IMS_ORG=your-ims-org-id@AdobeOrg

# Inference routing
INFERENCE_PROVIDERS=ollama,openai,airllm,vllm,andromeda,litellm,mock
CREATIVE_GENERATOR_MODEL=default
LITELLM_MODEL=anthropic/claude-3-5-haiku-latest

# Optional OpenAI-compatible Andromeda backend
ANDROMEDA_ENDPOINT=
ANDROMEDA_MODEL=meta-andromeda
ANDROMEDA_API_KEY=
ANDROMEDA_TIMEOUT_S=60

# Cognitive sleep / AutoDreaming runtime
SLEEP_ENABLED=1
SLEEP_CYCLE_INTERVAL_S=3600
SLEEP_WINDOW_HOURS=24
SLEEP_WORKSPACE=default

# Durable replay persistence
RUNTIME_REPLAY_DB=state/runtime_replay.duckdb

# Cycle ownership: leave false for a standalone API. docker-compose.yml sets
# this true for its API service because the separate orchestrator owns cycles.
ORCHESTRATOR_HANDLES_CYCLES=false

# Share the latest external signal batch across dashboard, snapshot, and
# content-planning reads. Ingestion explicitly refreshes it each cycle.
SIGNAL_CACHE_TTL_S=60

# Optional OSS capability integrations (disabled by default)
# Set true only after validating the configured sidecars/workers.
MARKETOS_OSS_DISCOVERY=false
MARKETOS_RESEARCH_URLS=
MARKETOS_OSS_CACHE_TTL_S=300
MARKETOS_OSS_MAX_RETRIES=2
MARKETOS_OSS_RETRY_BACKOFF_S=0.25
CRAWL4AI_ALLOWED_DOMAINS=
MEDUSA_BASE_URL=
MEDUSA_API_TOKEN=
MEDUSA_IMAGE=
MEDUSA_DATABASE_URL=
MEDUSA_REQUIRED_FOR_READY=false
POSTIZ_BASE_URL=
POSTIZ_API_TOKEN=
# Use the Postiz public API base, e.g. https://postiz.example/public/v1.
POSTIZ_INTEGRATION_ID=
POSTIZ_PUBLISH_PATH=/posts
POSTIZ_AUTH_SCHEME=
POSTIZ_POST_TYPE=draft
POSTIZ_PUBLISH_DATE=
POSTIZ_ANALYTICS_DAYS=30
POSTIZ_MAX_RETRIES=2
POSTIZ_RETRY_BACKOFF_S=0.25

# Optional typed campaign QA gate; unavailable/rejected QA fails closed.
MARKETOS_AGENT_QA_ENABLED=false
MARKETOS_DEFAULT_AD_PLATFORM=tiktok
MARKETOS_DEFAULT_SOCIAL_PLATFORM=instagram
BROWSER_USE_ALLOWED_DOMAINS=
BROWSER_USE_ENABLED=false
BROWSER_USE_HEADLESS=true
BROWSER_USE_MODEL=bu-2-0
MARKETOS_WEBHOOK_DEDUP_DB=:memory:
MARKETOS_WEBHOOK_LEARNING=true
MEDUSA_WEBHOOK_SECRET=
POSTIZ_WEBHOOK_SECRET=
N8N_BASE_URL=
N8N_API_KEY=
N8N_ALLOWED_WORKFLOWS=alerts,crm_sync,approval_reminder,export
N8N_WEBHOOK_PATH=/webhook/{workflow}
N8N_MAX_RETRIES=2
N8N_RETRY_BACKOFF_S=0.25
