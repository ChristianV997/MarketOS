# ─────────────────────────────────────────────────────────────────────────────
# Discovery adapters — real data, NO credentials needed (all optional/defaulted)
# ─────────────────────────────────────────────────────────────────────────────

# Amazon Best Sellers scrape (falls back to mock data if blocked)
AMAZON_BESTSELLER_CATEGORIES=beauty,electronics,home-kitchen,sports-outdoors,toys-games

# MercadoLibre public catalog search (no API key required)
MERCADOLIBRE_SITES=MLA,MLM,MLB
MERCADOLIBRE_QUERIES=electronica,hogar,belleza,deportes

# Reddit, Google Trends, YouTube (via pytrends) adapters need no env vars at all.

# Discovery signal cache TTL (hours) — how often SignalEngine.get() re-queries adapters
SIGNAL_CACHE_TTL_H=6

# ─────────────────────────────────────────────────────────────────────────────
# Discovery adapters — optional auth for higher-fidelity data
# ─────────────────────────────────────────────────────────────────────────────

# TikTok Creative Center (official trending-product API); without these,
# tiktok_organic.py falls back to a pytrends proxy, then mock data.
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# Meta Ad Library competitor-ad intelligence (used for market-saturation
# scoring, not product discovery itself); dry-run (deterministic mock) unless
# both are set.
ADLIB_DRY_RUN=true
META_ACCESS_TOKEN=

# Alibaba has no public API and is intentionally mock-only
# (backend/adapters/alibaba_trends.py) — no env var applies.

# ─────────────────────────────────────────────────────────────────────────────
# Revenue ground-truth sources (cross-platform attribution reconciliation)
# ─────────────────────────────────────────────────────────────────────────────

SHOPIFY_STORE_URL=mystore.myshopify.com
SHOPIFY_ACCESS_TOKEN=
STORE_DRY_RUN=true

STRIPE_SECRET_KEY=

# Set true once both Shopify/Stripe (or either) are configured, to have
# reconciled (deduplicated) revenue drive live decisions instead of just
# being journaled for comparison.
ATTRIBUTION_RECONCILE_LIVE=false

# ─────────────────────────────────────────────────────────────────────────────
# Ad platforms — already dry-run-safe; documented here for when API keys
# arrive in a later stage. NOT touched by the discovery-consolidation pass.
# ─────────────────────────────────────────────────────────────────────────────

META_AD_ACCOUNT_ID=
META_DRY_RUN=true
META_GRAPH_API_VERSION=v20.0

TIKTOK_DRY_RUN=true
TIKTOK_BUDGET_DAILY=
TIKTOK_SCALE_WIN_STREAK=
TIKTOK_SCALE_MULTIPLIER=
TIKTOK_KILL_SPEND_RATIO=
TIKTOK_KILL_ROAS_FLOOR=

# Adobe Journey Optimizer (campaign scale/pause orchestration)
ADOBE_AJO_TOKEN=your-ajo-bearer-token
ADOBE_IMS_ORG=your-ims-org-id@AdobeOrg
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_IMS_URL=
ADOBE_ORG_ID=
ADOBE_SANDBOX_NAME=

# Reserved for future use — no adapter reads these yet.
GA4_PROPERTY_ID=
GA4_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Pillar A ingestion scheduler (set true to enable hourly research runs)
# ─────────────────────────────────────────────────────────────────────────────

FF_PILLAR_A_INGESTION=true
INGESTION_CRON=0 * * * *
JOB_MAX_RETRIES=3

# Pillar A trend source adapter v1 (set true to enable Google Trends ingestion
# into the separate TrendRecordStore persistence layer — distinct from the
# SignalEngine-registered google_trends adapter above)
FF_PILLAR_A_SOURCE_V1=true
PILLAR_A_SOURCE_V1_GEO=US
PILLAR_A_SOURCE_V1_LANG=en-US
PILLAR_A_SOURCE_V1_MAX_PAGES=1
PILLAR_A_SOURCE_V1_TIMEOUT_SECONDS=15
PILLAR_A_SOURCE_V1_VELOCITY_BASELINE=1000
PILLAR_A_SOURCE_V1_CONFIDENCE_BASELINE=0.7

# Pillar A research persistence
RESEARCH_RETENTION_DAYS=30

# ─────────────────────────────────────────────────────────────────────────────
# Infrastructure / persistence
# ─────────────────────────────────────────────────────────────────────────────

# Supabase persistent state
# Required tables: system_state, events  (see backend/integrations/supabase_client.py)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# FRED / S&P macro signals — free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key
# Optional S&P Global premium (reserved for future use)
ICE_API_KEY=

# Celery (only relevant if running the worker/beat services from docker-compose.yml;
# the orchestrator's tick loop itself runs synchronously and doesn't require these)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false

# ─────────────────────────────────────────────────────────────────────────────
# Decision engine — shadow-mode feature flags (all default false/shadow)
# ─────────────────────────────────────────────────────────────────────────────

CAPITAL_POLICY_LIVE=false
SCORING_NORMALIZE_LIVE=false
REGIME_CONFIDENCE_WEIGHTING_LIVE=false
