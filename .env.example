# ─────────────────────────────────────────────────────────────────────────────
# Capital — currency of operator-supplied capital figures
# ─────────────────────────────────────────────────────────────────────────────

# INITIAL_CAPITAL is denominated in CAPITAL_CURRENCY (default USD — every ad
# platform integration in this codebase bills in USD). Set both together if
# funding the system in a different currency (e.g. CAPITAL_CURRENCY=MXN,
# INITIAL_CAPITAL=5000) — backend.core.fx.to_usd() converts once at startup
# using a static reference rate (see backend/core/fx.py). Leaving both unset
# preserves the exact previous default (1000.0 USD).
CAPITAL_CURRENCY=USD
INITIAL_CAPITAL=1000.0

# Current operating mode: research and simulation only. The PowerShell
# supervisor sets this explicitly as well; live providers must not be enabled
# until the dossier, tipping-point, and five-part human approval gate pass.
MARKETOS_RESEARCH_ONLY=true
MARKETOS_RESEARCH_OLLAMA=false
MARKETOS_RESEARCH_CATEGORY=fitness

# ─────────────────────────────────────────────────────────────────────────────
# Dropship suppliers — live quoting/ordering (dry-run by default without these)
# ─────────────────────────────────────────────────────────────────────────────

# CJ Dropshipping — https://developers.cjdropshipping.com
# Both required: CJ's real API exchanges (email, API key) for a short-lived
# access/refresh token pair (backend.validation.suppliers._CJTokenManager) —
# the API key alone is never sent as a request header directly.
CJ_EMAIL=
CJ_API_KEY=

# Zendrop, Spocket, Printful, AutoDS — each optional/independent; every
# supplier client falls back to a deterministic mock quote until its key
# is set (backend.validation.suppliers). AutoDS aggregates AliExpress/
# Walmart/Amazon sourcing behind one API (account approval + a one-time
# activation fee required — see autods.com/api).
ZENDROP_API_KEY=
SPOCKET_API_KEY=
PRINTFUL_API_KEY=
AUTODS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Discovery adapters — real data, NO credentials needed (all optional/defaulted)
# ─────────────────────────────────────────────────────────────────────────────

# Amazon Best Sellers scrape (falls back to mock data if blocked)
# pet-supplies/baby-products included: high organic-virality niches (see
# backend/adapters/tiktok_organic.py's mock signals for why) worth
# discovering products in even before live credentials are configured.
AMAZON_BESTSELLER_CATEGORIES=beauty,electronics,home-kitchen,sports-outdoors,toys-games,pet-supplies,baby-products

# MercadoLibre public catalog search (no API key required)
MERCADOLIBRE_SITES=MLA,MLM,MLB
MERCADOLIBRE_QUERIES=electronica,hogar,belleza,deportes,mascotas,bebes

# Reddit, Google Trends, YouTube (via pytrends) adapters need no env vars at all.

# Alibaba wholesale/bulk listings via Firecrawl (firecrawl.dev) — optional;
# falls back to the honest mock catalog when unset (Alibaba has no public
# API and blocks scripted scraping, see backend/adapters/alibaba_trends.py).
FIRECRAWL_API_KEY=
ALIBABA_SEARCH_QUERIES=wireless earbuds,water bottle,led strip light,yoga mat,phone case

# Discovery signal cache TTL (hours) — how often SignalEngine.get() re-queries adapters
SIGNAL_CACHE_TTL_H=6

# ─────────────────────────────────────────────────────────────────────────────
# Discovery adapters — optional auth for higher-fidelity data
# ─────────────────────────────────────────────────────────────────────────────

# TikTok Creative Center (official trending-product API); without these,
# tiktok_organic.py falls back to a pytrends proxy, then mock data.
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# Meta Ad Library competitor-ad intelligence (used for market-saturation
# scoring, not product discovery itself); dry-run (deterministic mock) unless
# both are set.
ADLIB_DRY_RUN=true
META_ACCESS_TOKEN=

# NOTE: core/sensors/tiktok_client.py (RAPIDAPI_KEY) and
# connectors/tiktok_connector.py (TIKTOK_RESEARCH_TOKEN) are a second,
# unwired TikTok client pair — not called by the live discovery pipeline
# (backend/adapters/tiktok_organic.py above is the one that runs). Listed
# here only so the gap is documented; wiring them in is a separate decision.
RAPIDAPI_KEY=
TIKTOK_RESEARCH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Revenue ground-truth sources (cross-platform attribution reconciliation)
# ─────────────────────────────────────────────────────────────────────────────

SHOPIFY_STORE_URL=mystore.myshopify.com
SHOPIFY_ACCESS_TOKEN=
STORE_DRY_RUN=true

STRIPE_SECRET_KEY=

# Set true once both Shopify/Stripe (or either) are configured, to have
# reconciled (deduplicated) revenue drive live decisions instead of just
# being journaled for comparison.
ATTRIBUTION_RECONCILE_LIVE=false

# ─────────────────────────────────────────────────────────────────────────────
# Stack Planner / Cost Engine adapters (backend/stack_planner, backend/costs)
# — dry-run by default; fee-estimation works even with zero credentials.
# See docs/STACK_PLANNER.md and docs/COST_AWARE_INTEGRATION_AUDIT.md.
# ─────────────────────────────────────────────────────────────────────────────

WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Reuses STRIPE_SECRET_KEY (above) for the Stripe MX payment-fee adapter.
MERCADOPAGO_ACCESS_TOKEN=

# Chatwoot conversation record-keeping (optional; the sales automation path
# remains draft-only and requires explicit --attempt-real-handoff opt-in).
CHATWOOT_BASE_URL=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=

# Provider Registry catalog / fee-model overrides — optional, override the
# documented default estimates in backend/providers/provider_catalog.py and
# backend/integrations/{stripe_mx,mercado_pago_mx}.py.
PROVIDER_STRIPE_MX_FEE_PCT=
PROVIDER_STRIPE_MX_FEE_FIXED_MXN=
PROVIDER_MERCADOPAGO_MX_FEE_PCT=
PROVIDER_MERCADOPAGO_MX_FEE_FIXED_MXN=

# ─────────────────────────────────────────────────────────────────────────────
# Ad platforms — already dry-run-safe; documented here for when API keys
# arrive in a later stage. NOT touched by the discovery-consolidation pass.
# ─────────────────────────────────────────────────────────────────────────────

META_AD_ACCOUNT_ID=
META_DRY_RUN=true
META_GRAPH_API_VERSION=v20.0

TIKTOK_DRY_RUN=true
TIKTOK_BUDGET_DAILY=
TIKTOK_SCALE_WIN_STREAK=
TIKTOK_SCALE_MULTIPLIER=
TIKTOK_KILL_SPEND_RATIO=
TIKTOK_KILL_ROAS_FLOOR=

# Adobe Journey Optimizer (campaign scale/pause orchestration) — OAuth 2.0
# client-credentials flow
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_ORG_ID=your-ims-org-id@AdobeOrg
ADOBE_SANDBOX_NAME=
ADOBE_IMS_URL=
ADOBE_SANDBOX_NAME=

# Reserved for future use — no adapter reads these yet.
GA4_PROPERTY_ID=
GA4_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Pillar A ingestion scheduler (set true to enable hourly research runs)
# ─────────────────────────────────────────────────────────────────────────────

FF_PILLAR_A_INGESTION=true
INGESTION_CRON=0 * * * *
JOB_MAX_RETRIES=3

# Pillar A trend source adapter v1 (set true to enable Google Trends ingestion
# into the separate TrendRecordStore persistence layer — distinct from the
# SignalEngine-registered google_trends adapter above)
FF_PILLAR_A_SOURCE_V1=true
PILLAR_A_SOURCE_V1_GEO=US
PILLAR_A_SOURCE_V1_LANG=en-US
PILLAR_A_SOURCE_V1_MAX_PAGES=1
PILLAR_A_SOURCE_V1_TIMEOUT_SECONDS=15
PILLAR_A_SOURCE_V1_VELOCITY_BASELINE=1000
PILLAR_A_SOURCE_V1_CONFIDENCE_BASELINE=0.7

# Pillar A research persistence
RESEARCH_RETENTION_DAYS=30

# ─────────────────────────────────────────────────────────────────────────────
# Infrastructure / persistence
# ─────────────────────────────────────────────────────────────────────────────

# Supabase persistent state
# Required tables: system_state, events  (see backend/integrations/supabase_client.py)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# FRED / S&P macro signals — free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key
# Optional S&P Global premium (reserved for future use)
ICE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Alerting — where error-level alerts (backend.monitoring.alerts) get pushed
# ─────────────────────────────────────────────────────────────────────────────

# Both optional and independent; each is a no-op until its own credential is
# set (same "presence of the credential is the opt-in" convention as every
# other integration here) — alerts always still write to state/alerts.jsonl
# and the log regardless of whether either is configured.
SLACK_WEBHOOK=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Sentry — exception tracking (backend.observability.sentry_init)
# ─────────────────────────────────────────────────────────────────────────────

# No-op until SENTRY_DSN is set (same "presence of the credential is the
# opt-in" convention as every other integration here). Layers under, not
# instead of, the Slack/Telegram business-logic alerts above.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0

# ─────────────────────────────────────────────────────────────────────────────
# Decision engine — shadow-mode feature flags (all default false/shadow)
# ─────────────────────────────────────────────────────────────────────────────

CAPITAL_POLICY_LIVE=false
SCORING_NORMALIZE_LIVE=false
REGIME_CONFIDENCE_WEIGHTING_LIVE=false

# Blend the per-product LinUCB contextual bandit's real UCB score
# (backend.learning.contextual_bandit.product_bandit) into decide()'s
# bandit_w term. Always journaled as shadow_product_bandit_weighting;
# only affects the live score when true.
PRODUCT_BANDIT_LIVE=false

# Live budget actuation: apply_scaling_decisions() always journals what it
# WOULD do (shadow_budget_apply); only calls pause_campaign()/scale_budget()
# on the real platform (behind backend.risk.gate) when this is true.
BUDGET_APPLY_LIVE=false

# ─────────────────────────────────────────────────────────────────────────────
# Inference routing (backend/inference/router.py)
# ─────────────────────────────────────────────────────────────────────────────

# NOTE: "andromeda" here is a provider merged in from origin/main during
# branch unification — see the plan's Step 2 triage (verify it's real/wired
# before trusting it in production; if unwired/speculative, drop it from
# this list and delete backend/inference/providers/andromeda.py).
INFERENCE_PROVIDERS=ollama,openai,airllm,vllm,andromeda,litellm,mock
# Local Ollama worker (optional; keep live external actions approval-gated).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_S=30
OLLAMA_HEALTH_TIMEOUT_S=0.25
CREATIVE_GENERATOR_MODEL=default
LITELLM_MODEL=anthropic/claude-3-5-haiku-latest

# When true (default), RoutingPolicy re-sorts the fallback chain
# cheapest-first (backend/inference/policies/cost_policy.py) so free local
# providers (Ollama, AirLLM, vLLM, ...) win over paid cloud providers even
# if INFERENCE_PROVIDERS reorders them. Mock always stays last regardless.
PREFER_LOCAL_INFERENCE=true

# Local Ollama daemon (backend/inference/providers/ollama.py,
# backend/ollama_manager.py). OLLAMA_MODEL must match a key in
# ollama_manager's RECOMMENDED_MODELS (mistral:7b, llama3.2:3b,
# neural-chat:7b) for accurate resource-sizing estimates — a lighter model
# such as qwen2.5:0.5b works for bounded low-risk local dev tasks (see
# docs/ai/OLLAMA_BENCHMARK.md) but falls back to the conservative unknown-
# model sizing estimate since it isn't in that table.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b
OLLAMA_AUTO_START=false
OLLAMA_TIMEOUT_S=30
OLLAMA_HEALTH_TIMEOUT_S=0.25

# ─────────────────────────────────────────────────────────────────────────────
# AWS standby (backend/aws/heartbeat.py, deploy/aws/main.tf, orchestrator/main.py)
# ─────────────────────────────────────────────────────────────────────────────

# Unset on the PC (primary) — it just ticks immediately. Set to true only on
# the AWS instance's env, via deploy/aws/main.tf's user_data: it then blocks
# in _await_takeover() until the primary's S3 heartbeat goes stale.
ORCHESTRATOR_STANDBY=false
AWS_TAKEOVER_AFTER_S=300
ORCHESTRATOR_STANDBY_POLL_S=30
MARKETOS_NODE_NAME=pc

# Shared by both the primary (which pushes) and the standby (which polls).
# Unset (default) disables the whole heartbeat mechanism — push/check both
# fail soft to False/None, same as boto3 being uninstalled.
MARKETOS_HEARTBEAT_BUCKET=
MARKETOS_HEARTBEAT_KEY=orchestrator/heartbeat.json

# Optional OpenAI-compatible Andromeda backend
ANDROMEDA_ENDPOINT=
ANDROMEDA_MODEL=meta-andromeda
ANDROMEDA_API_KEY=
ANDROMEDA_TIMEOUT_S=60

# Cognitive sleep / AutoDreaming runtime
SLEEP_ENABLED=1
SLEEP_CYCLE_INTERVAL_S=3600
SLEEP_WINDOW_HOURS=24
SLEEP_WORKSPACE=default

# Durable replay persistence
RUNTIME_REPLAY_DB=state/runtime_replay.duckdb

# Cycle ownership: leave false for a standalone API. docker-compose.yml sets
# this true for its API service because the separate orchestrator owns cycles.
ORCHESTRATOR_HANDLES_CYCLES=false

# Share the latest external signal batch across dashboard, snapshot, and
# content-planning reads. Ingestion explicitly refreshes it each cycle.
SIGNAL_CACHE_TTL_S=60

# Optional OSS capability integrations (disabled by default)
# Set true only after validating the configured sidecars/workers.
MARKETOS_OSS_DISCOVERY=false
MARKETOS_RESEARCH_URLS=
MARKETOS_OSS_CACHE_TTL_S=300
MARKETOS_OSS_MAX_RETRIES=2
MARKETOS_OSS_RETRY_BACKOFF_S=0.25
CRAWL4AI_ALLOWED_DOMAINS=
CRAWL4AI_RAW_CACHE_TTL_S=900
CRAWL4AI_RAW_CACHE_MAX_ENTRIES=100
MARKETOS_OSS_MAX_CONCURRENCY=4
MEDUSA_BASE_URL=
MEDUSA_API_TOKEN=
MEDUSA_IMAGE=
MEDUSA_DATABASE_URL=
MEDUSA_REQUIRED_FOR_READY=false
POSTIZ_BASE_URL=
POSTIZ_API_TOKEN=
# Use the Postiz public API base, e.g. https://postiz.example/public/v1.
POSTIZ_ALLOWED_HOSTS=api.postiz.com,postiz
POSTIZ_HEALTH_PATH=/integrations
POSTIZ_INTEGRATION_ID=
POSTIZ_COMMERCIAL_APPROVED=false
POSTIZ_PUBLISH_PATH=/posts
POSTIZ_AUTH_SCHEME=
POSTIZ_POST_TYPE=draft
POSTIZ_PUBLISH_DATE=
POSTIZ_ANALYTICS_DAYS=30
POSTIZ_MAX_RETRIES=2
POSTIZ_RETRY_BACKOFF_S=0.25

# Optional typed campaign QA gate; unavailable/rejected QA fails closed.
MARKETOS_AGENT_QA_ENABLED=false
MARKETOS_DEFAULT_AD_PLATFORM=tiktok
MARKETOS_DEFAULT_SOCIAL_PLATFORM=instagram
BROWSER_USE_ALLOWED_DOMAINS=
# Browser Use runs in the isolated `browser-use-worker` service. Set the
# URL/token through the OSS Compose overlay; do not enable it in the API.
BROWSER_USE_WORKER_URL=
BROWSER_USE_WORKER_TOKEN=
BROWSER_USE_WORKER_HTTP_TIMEOUT_S=125
BROWSER_USE_VERSION=0.13.6
# Deprecated development escape hatch only; production must use the sidecar.
BROWSER_USE_LOCAL_DEVELOPMENT=false
BROWSER_USE_HEADLESS=true
BROWSER_USE_MODEL=bu-2-0
MARKETOS_WEBHOOK_DEDUP_DB=:memory:
MARKETOS_WEBHOOK_LEARNING=true
MEDUSA_WEBHOOK_SECRET=
POSTIZ_WEBHOOK_SECRET=
N8N_BASE_URL=
# Restrict the adapter to private/internal n8n hosts (e.g. n8n or n8n.internal).
N8N_ALLOWED_HOSTS=
# Shared secret validated by the n8n Webhook workflow's Header Auth node.
N8N_WEBHOOK_TOKEN=
N8N_API_KEY=
N8N_ALLOWED_WORKFLOWS=alerts,crm_sync,approval_reminder,export
N8N_WEBHOOK_PATH=/webhook/{workflow}
N8N_HEALTH_PATH=/healthz
N8N_MAX_RETRIES=2
N8N_RETRY_BACKOFF_S=0.25

# ─────────────────────────────────────────────────────────────────────────────
# Obsidian sync (orchestrator/main.py's _run_obsidian_sync, core/brain/sync.py)
# ─────────────────────────────────────────────────────────────────────────────

# Unset by default — the worker no-ops (status: skipped) until this points
# at a real vault directory (created if missing). The daemon install script
# (scripts/install_daemon.sh) sets this to ~/marketos-data/obsidian-vault.
OBSIDIAN_VAULT_PATH=
OBSIDIAN_SYNC_MIN_INTERVAL_S=3600
