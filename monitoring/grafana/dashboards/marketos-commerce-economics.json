{
  "uid": "marketos-commerce-economics",
  "title": "MarketOS Commerce Economics",
  "tags": ["marketos", "commerce", "economics"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Last Cycle Blended ROAS",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "marketos-prometheus"},
      "targets": [{"refId": "A", "expr": "marketos_commerce_cycle_last_roas", "legendFormat": "ROAS"}],
      "fieldConfig": {"defaults": {"unit": "none", "min": 0, "max": 3, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 1.0}, {"color": "green", "value": 1.5}]}}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Spend vs Revenue",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "marketos-prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(marketos_commerce_cycle_spend_total[15m]))", "legendFormat": "spend/s"},
        {"refId": "B", "expr": "sum(rate(marketos_commerce_cycle_revenue_total[15m]))", "legendFormat": "revenue/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Launchable Rate",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "marketos-prometheus"},
      "targets": [{"refId": "A", "expr": "100 * sum(increase(marketos_commerce_cycle_launchable_total[1h])) / clamp_min(sum(increase(marketos_commerce_cycle_ranked_total[1h])), 0.001)", "legendFormat": "launchable %"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 20}, {"color": "green", "value": 50}]}}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ranked vs Launchable Opportunities",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 8},
      "datasource": {"type": "prometheus", "uid": "marketos-prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(marketos_commerce_cycle_ranked_total[15m]))", "legendFormat": "ranked/s"},
        {"refId": "B", "expr": "sum(rate(marketos_commerce_cycle_launchable_total[15m]))", "legendFormat": "launchable/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Rejection Reasons",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "marketos-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (reason) (increase(marketos_commerce_cycle_rejection_reasons_total[1h]))", "legendFormat": "{{reason}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    }
  ]
}
