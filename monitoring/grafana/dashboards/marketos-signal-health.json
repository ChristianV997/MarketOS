{
  "uid": "marketos-signal-health",
  "title": "MarketOS Signal Health",
  "tags": ["marketos", "signals", "cache"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Signal Cache Hit Rate",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "marketos-prometheus"},
      "targets": [{"refId": "A", "expr": "100 * sum(rate(marketos_signal_cache_hits_total[10m])) / clamp_min(sum(rate(marketos_signal_cache_lookups_total[10m])), 0.001)", "legendFormat": "hit rate"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 50}, {"color": "green", "value": 80}]}}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Signal Refresh Latency (p95)",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "marketos-prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(marketos_signal_cache_refresh_duration_seconds_bucket[10m])))", "legendFormat": "p95 seconds"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2}, {"color": "red", "value": 5}]}}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Source Failures by Source",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "marketos-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (source) (increase(marketos_signal_source_failures_total[15m]))", "legendFormat": "{{source}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cache Operations",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "marketos-prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(marketos_signal_cache_hits_total[10m]))", "legendFormat": "hits/s"},
        {"refId": "B", "expr": "sum(rate(marketos_signal_cache_lookups_total[10m]))", "legendFormat": "lookups/s"},
        {"refId": "C", "expr": "sum(rate(marketos_signal_cache_refreshes_total[10m]))", "legendFormat": "refreshes/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Source Refresh Latency (p95)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "marketos-prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (source, le) (rate(marketos_signal_source_refresh_duration_seconds_bucket[10m])))", "legendFormat": "{{source}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2}, {"color": "red", "value": 5}]}}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Source Success and Failure Rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "marketos-prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (source) (rate(marketos_signal_source_successes_total[15m]))", "legendFormat": "{{source}} successes/s"},
        {"refId": "B", "expr": "sum by (source) (rate(marketos_signal_source_failures_total[15m]))", "legendFormat": "{{source}} failures/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "OSS Provider Refresh Latency (p95)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "marketos-prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (provider, le) (rate(marketos_oss_provider_refresh_duration_seconds_bucket[10m])))", "legendFormat": "{{provider}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2}, {"color": "red", "value": 5}]}}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Sidecar Webhook Outcomes",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "datasource": {"type": "prometheus", "uid": "marketos-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (source, outcome) (rate(marketos_integration_webhook_events_total[15m]))", "legendFormat": "{{source}} / {{outcome}}"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Configured Sidecar Reachability",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "datasource": {"type": "prometheus", "uid": "marketos-prometheus"},
      "targets": [{"refId": "A", "expr": "marketos_integration_reachable", "legendFormat": "{{integration}}"}],
      "fieldConfig": {"defaults": {"unit": "bool", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Integration Health Probe Latency (p95)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "datasource": {"type": "prometheus", "uid": "marketos-prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (integration, le) (rate(marketos_integration_health_probe_duration_seconds_bucket[10m])))", "legendFormat": "{{integration}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}}
    }
  ]
}
