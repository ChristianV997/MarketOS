{
  "name": "MarketOS",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": ". .venv/bin/activate && uvicorn backend.api:app --host 0.0.0.0 --port 3000",
      "description": "FastAPI backend + background decision loop (http://localhost:3000)."
    },
    {
      "name": "frontend",
      "command": "npm --prefix frontend run dev -- --host",
      "description": "Vite React dashboard, proxies /api and /ws to the backend (http://localhost:5173)."
    }
  ],
  "ports": [
    { "name": "backend", "port": 3000 },
    { "name": "frontend", "port": 5173 }
  ]
}
