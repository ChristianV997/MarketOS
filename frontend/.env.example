# Backend API base URL used by frontend/src/lib/api.ts. Leave unset in dev —
# the vite.config.ts dev proxy forwards /api and /ws to the backend already.
# VITE_API_URL=

# PostHog product analytics — optional, default off (see
# frontend/src/lib/posthog.ts). Leave unset to disable analytics entirely;
# every capture call becomes a no-op with no network activity.
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
