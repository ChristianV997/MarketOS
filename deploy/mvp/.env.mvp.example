# MarketOS MVP Island: configuration only. Copy locally; never commit secrets.
# The MVP is advisory and dry-run by default.

# Core
MARKETOS_MVP_MODE=0
MARKETOS_STATE_DIR=state
ALLOWED_ORIGINS=http://localhost:5173
PORT=8000
ORCHESTRATOR_HANDLES_CYCLES=true
SLEEP_ENABLED=0

# API / frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Supabase (optional; canonical EventRepository adapter is never the default)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Explicit staging-only gate. JSONL remains default even when credentials exist.
MARKETOS_SUPABASE_CANONICAL_EVENTS=0

# Upstash / QStash (deferred: no queue or scheduler is enabled by this profile)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=

# Cloudflare (optional DNS/CDN/WAF only; no Worker or AI Gateway path is enabled)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Telemetry and reports (all adapters remain disabled without values)
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# AI routing evaluation only. Do not expose keys to frontend bundles.
OPENROUTER_API_KEY=
CLOUDFLARE_AI_GATEWAY_URL=
VERCEL_AI_GATEWAY_URL=
NINE_ROUTER_API_KEY=

# Public signal ingestion: fixture/cache mode is safe by default.
# A manual CLI invocation must also pass --allow-network for any real read.
MARKETOS_PUBLIC_SIGNAL_NETWORK=0
MARKETOS_PUBLIC_COMMERCE_RUNS=0
MARKETOS_PUBLIC_RUN_RATE_LIMIT=10
MARKETOS_PUBLIC_RUN_RATE_WINDOW_SECONDS=600
MARKETOS_EVENT_READ_RATE_LIMIT=300
MARKETOS_EVENT_READ_RATE_WINDOW_SECONDS=600
MARKETOS_PUBLIC_SIGNAL_CACHE_DIR=artifacts/public-signal-cache
# Server-side paths; API read/write remains constrained to artifacts/.
MARKETOS_EVENT_READ_JSONL_PATH=artifacts/commerce-mvp-live-events.jsonl
# API JSONL writes are server-side only and require an explicit event target.
MARKETOS_EVENT_WRITE_JSONL_PATH=artifacts/commerce-mvp-live-events.jsonl

# MVP safety gates: all commerce and shadow promotions remain disabled.
TIKTOK_DRY_RUN=true
META_DRY_RUN=true
STORE_DRY_RUN=true
SUPPLIERS_DRY_RUN=true
# Optional authenticated supplier evidence. This catalog path is read-only and
# remains disabled until an operator deliberately opens the gate.
MARKETOS_SUPPLIER_PROVIDER=cj
MARKETOS_SUPPLIER_AUTH_READONLY=0
CJ_EMAIL=
CJ_API_KEY=
ADLIB_DRY_RUN=true
ATTRIBUTION_RECONCILE_LIVE=0
CAPITAL_POLICY_LIVE=0
SCORING_NORMALIZE_LIVE=0
CALIBRATION_HOLDOUT_LIVE=0
REGIME_CONFIDENCE_WEIGHTING_LIVE=0
RISK_ADAPTIVE_LIVE=0
GEO_ECONOMICS_LIVE=0
SUPPLIER_RISK_RANKING_LIVE=0
SUPPLIER_FEEDBACK_LIVE=0
PHASE7_AB_TEST_VALIDITY_LIVE=0
PHASE7_FATIGUE_DETECTION_LIVE=0
PHASE7_URGENCY_SCORING_LIVE=0
PHASE7_MONTE_CARLO_LIVE=0
PHASE8_ORGANIC_CHANNEL_LIVE=0
PHASE8_AFFILIATE_SCALING_LIVE=0
