{
  "profile_version": 1,
  "name": "marketos-mvp-island",
  "description": "Minimal deployable, advisory-only MarketOS slice.",
  "enabled_modules": [
    "public_signal_ingestion",
    "canonical_events",
    "supabase_event_adapter_when_configured",
    "dry_run_opportunity_analysis",
    "dry_run_unit_economics",
    "advisory_reports",
    "api_read_views",
    "manual_export",
    "manual_approval",
    "saas_capability_router_metadata"
  ],
  "disabled_modules": [
    "live_ads",
    "shopify_mutation",
    "provider_mutations",
    "payments_orders_fulfillment",
    "autonomous_budget_mutation",
    "background_orchestrator_loop",
    "dao_future",
    "heavy_vector_memory",
    "experimental_modules"
  ],
  "required_env_vars": ["MARKETOS_MVP_MODE", "ALLOWED_ORIGINS"],
  "optional_env_vars": [
    "SUPABASE_URL", "SUPABASE_SERVICE_ROLE_KEY", "SUPABASE_ANON_KEY",
    "SENTRY_DSN", "POSTHOG_PROJECT_API_KEY", "RESEND_API_KEY",
    "UPSTASH_REDIS_REST_URL", "UPSTASH_REDIS_REST_TOKEN", "QSTASH_TOKEN",
    "CLOUDFLARE_API_TOKEN", "OPENROUTER_API_KEY", "MARKETOS_PUBLIC_SIGNAL_NETWORK"
  ],
  "service_dependencies": {
    "supabase": "optional_persistence_auth_storage",
    "vercel": "recommended_frontend_host",
    "railway_or_render": "recommended_fastapi_host",
    "cloudflare": "optional_dns_cdn_waf",
    "upstash": "deferred_queue_scheduler",
    "posthog": "optional_telemetry",
    "sentry": "optional_error_tracking",
    "resend": "deferred_transactional_email",
    "ai_gateway": "evaluate_only"
  },
  "startup_command": "uvicorn backend.api:app --host 0.0.0.0 --port ${PORT:-8000}",
  "health_endpoints": ["/health", "/ready"],
  "readiness_checks": ["profile", "required_files", "environment", "live_flags", "supabase_schema", "frontend"],
  "manual_only_actions": ["public_network_read", "event_export", "opportunity_review", "approval"],
  "forbidden_actions": ["launch", "spend", "publish", "shopify_mutate", "order", "payment", "fulfillment", "provider_mutate", "background_loop"],
  "supported_saas_providers": ["Supabase", "Vercel", "Railway", "Render", "Cloudflare", "Upstash", "PostHog", "Sentry", "Resend"],
  "deployment_targets": ["vercel_frontend", "railway_fastapi", "render_fastapi"],
  "live_commerce_flags": [
    "TIKTOK_DRY_RUN", "META_DRY_RUN", "STORE_DRY_RUN", "SUPPLIERS_DRY_RUN", "ADLIB_DRY_RUN",
    "ATTRIBUTION_RECONCILE_LIVE", "CAPITAL_POLICY_LIVE", "SCORING_NORMALIZE_LIVE", "CALIBRATION_HOLDOUT_LIVE",
    "REGIME_CONFIDENCE_WEIGHTING_LIVE", "RISK_ADAPTIVE_LIVE", "GEO_ECONOMICS_LIVE", "SUPPLIER_RISK_RANKING_LIVE",
    "SUPPLIER_FEEDBACK_LIVE", "PHASE7_AB_TEST_VALIDITY_LIVE", "PHASE7_FATIGUE_DETECTION_LIVE",
    "PHASE7_URGENCY_SCORING_LIVE", "PHASE7_MONTE_CARLO_LIVE", "PHASE8_ORGANIC_CHANNEL_LIVE", "PHASE8_AFFILIATE_SCALING_LIVE"
  ]
}
