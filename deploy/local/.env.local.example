# MarketOS local runtime — credential-free, dry-run defaults.
# Copy to the repository root as `.env` when using Docker Compose:
#   cp deploy/local/.env.local.example .env
#
# For bare-metal Uvicorn (no Docker), export the same values or source this file.
# No secret values belong here; placeholders only.

# Cycle ownership: orchestrator owns cycles in the multi-service Compose stack.
ORCHESTRATOR_HANDLES_CYCLES=true
SLEEP_ENABLED=0
STATE_PATH=state/state.db

# Keep scheduled research ingestion and source fan-out disabled for offline smoke.
FF_PILLAR_A_INGESTION=false
FF_PILLAR_A_SOURCE_V1=false
FF_RESEARCH_SOURCE_GOOGLE_TRENDS_V1=false
FF_RESEARCH_SOURCE_REDDIT=false
FF_RESEARCH_SOURCE_MERCADOLIBRE=false
FF_RESEARCH_SOURCE_YOUTUBE=false
FF_RESEARCH_SOURCE_AMAZON_BESTSELLERS=false
FF_RESEARCH_SOURCE_TIKTOK_ORGANIC=false
FF_RESEARCH_SWARM_ENABLED=false

# Commerce and provider mutation gates remain dry-run / off.
TIKTOK_DRY_RUN=true
META_DRY_RUN=true
STORE_DRY_RUN=true
SUPPLIERS_DRY_RUN=true
ADLIB_DRY_RUN=true
MARKETOS_PUBLIC_COMMERCE_RUNS=0
MARKETOS_PUBLIC_SIGNAL_NETWORK=0
COMMERCE_LOOP_LIVE=false

# Optional local infrastructure (Compose supplies Redis/Qdrant service DNS names).
REDIS_URL=redis://redis:6379/0
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# CORS for the Vite dev server when the API is started outside Compose.
ALLOWED_ORIGINS=http://localhost:5173
